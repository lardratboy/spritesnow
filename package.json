{
  "name": "spritesnow",
  "version": "0.0.1",
  "private": true,
  "description": "2D procedural sprite generator with a pure, tested core and an explicit symmetry-group engine",
  "type": "module",
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "test": "node --test test/*.test.js",
    "test:browser": "node --test --test-concurrency=1 test/browser/*.test.js",
    "golden": "node tools/make-golden.js",
    "golden:tiers": "node tools/make-golden-tiers.js",
    "measure": "node tools/measurements/foldcheck.js && node tools/measurements/groups.js"
  }
}
